DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/fndb
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60

# SMTP (e.g. Gmail: smtp.gmail.com / 587 / your account + app password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com

# Where the password-reset link in the email points
FRONTEND_RESET_URL=http://localhost:5173/reset-password

WEB_SEARCH_API_KEY=
CONFIDENCE_THRESHOLD=0.80
